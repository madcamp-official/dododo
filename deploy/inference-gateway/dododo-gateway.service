[Unit]
Description=DoDoDo Inference Gateway
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=dododo
Group=dododo
WorkingDirectory=/opt/dododo
EnvironmentFile=/etc/dododo-gateway.env
ExecStart=/usr/local/bin/node apps/inference-gateway/src/index.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dododo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
