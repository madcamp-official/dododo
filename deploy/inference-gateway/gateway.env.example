GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18080
GATEWAY_DB_PATH=/var/lib/dododo/gateway.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=gemma3:12b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=900000

GATEWAY_MAX_CONCURRENT_JOBS=1
GATEWAY_MAX_QUEUE_SIZE=32
GATEWAY_DAILY_JOB_LIMIT=50
GATEWAY_JOB_TTL_MINUTES=30
GATEWAY_POLL_AFTER_MS=2000
GATEWAY_MAX_TEXT_BYTES=50000
GATEWAY_MAX_IMAGE_BYTES=5000000
GATEWAY_MAX_IMAGES=1
GATEWAY_MAX_SCHEMA_BYTES=50000

# 둘 중 하나 이상 필요하다. 실제 값은 Git에 커밋하지 않는다.
# GATEWAY_BEARER_TOKENS=긴_임시_운영자_토큰
# GATEWAY_ACTIVATION_CODES=일회용_설치_코드1,일회용_설치_코드2
